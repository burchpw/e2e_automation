# Ignore local node_modules and PnP execution files
node_modules/
.pnp.*

# Ignore the Yarn directory by default (including install-state.gz)
.yarn/*

# Un-ignore the critical Yarn 4 engine and configuration files
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Used by dotenv library to load environment variables.
.env

# Ignore Rubymine .idea files
.idea/

## Environment normalization:
/.bundle/
/vendor/bundle
/lib/bundler/man/

# Ignore contents test_result folders
test_results/
test_results/screenshot/

# Keep folder in Git
!test_results/.gitkeep
!test_results/screenshot/.gitkeep

playwright_js/.yarn/install-state.gz
